# ---------- Server ----------
NODE_ENV=development
PORT=4000
# Public URL of this API (used for upload URLs and payment callbacks). Must be HTTPS in production.
PUBLIC_URL=http://localhost:4000
# Comma-separated list of allowed web origins (customer web + admin web). Empty = allow all (dev only).
CORS_ORIGINS=
JWT_SECRET=change-me-to-a-long-random-string
# Encrypts the payment keys saved in Admin > Settings > Payment methods (defaults to JWT_SECRET). Changing it means re-entering them.
SETTINGS_SECRET=
JWT_EXPIRES_IN_SECONDS=2592000
UPLOAD_DIR=uploads
ORDER_PAYMENT_TIMEOUT_MINUTES=15

# ---------- Database (PostgreSQL) ----------
DATABASE_URL=postgresql://babymama:babymama@localhost:5432/babymama?schema=public

# ---------- Seed ----------
SEED_ADMIN_EMAIL=admin@babymama.co.ke
SEED_ADMIN_PASSWORD=ChangeMe123!

# ---------- Google Sign-In ----------
# Comma-separated OAuth client IDs accepted as token audience (Web client ID + iOS client ID).
# REQUIRED to enable Google sign-in: if empty, Google sign-in is refused (a token minted for any
# other app would otherwise be accepted). Email/password and phone sign-in still work.
GOOGLE_CLIENT_IDS=

# ---------- SMS sign-in (phone number + one-time code) ----------
# Also editable at runtime in Admin > Settings > Sign-in by SMS (no redeploy needed).
# When true (default outside production), the code is logged instead of sent — for development.
SMS_MOCK=
# Alphanumeric sender name or short code shown to the recipient (optional).
SMS_SENDER_ID=
# Africa's Talking (africastalking.com). Use username "sandbox" to test.
AT_USERNAME=
AT_API_KEY=

# ---------- Payments ----------
# When true and a provider has no credentials, payments are simulated (auto-success after a few seconds).
PAYMENTS_MOCK=true
CASH_ON_DELIVERY=true

# M-Pesa (Safaricom Daraja) - STK Push
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
# CustomerPayBillOnline (paybill) or CustomerBuyGoodsOnline (till)
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
# Till number when using Buy Goods (leave empty for paybill)
MPESA_PARTY_B=
# Secret path segment protecting the callback URL
MPESA_CALLBACK_TOKEN=change-me-mpesa-callback

# Airtel Money (Airtel Africa Open API)
AIRTEL_ENV=sandbox
AIRTEL_CLIENT_ID=
AIRTEL_CLIENT_SECRET=
AIRTEL_CALLBACK_TOKEN=change-me-airtel-callback

# Flutterwave (cards + M-Pesa via hosted checkout)
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=
FLUTTERWAVE_REDIRECT_URL=https://babymama.co.ke/payment-complete

# ---------- WooCommerce (optional) ----------
WOO_URL=
WOO_CONSUMER_KEY=
WOO_CONSUMER_SECRET=
WOO_WEBHOOK_SECRET=
# Push stock changes made in the app back to WooCommerce
WOO_PUSH_STOCK=true
# Create products added in the Babymama admin inside WooCommerce too
WOO_PUSH_PRODUCTS=false
# Copy paid orders into WooCommerce
WOO_PUSH_ORDERS=false
